{{> layout/header}}

<div class="container p-5">

    {{! 수정, 삭제 버튼: 오른쪽 정렬 }}
    <div class="d-flex justify-content-end">
        <a href="/board/{{board.id}}/update" class="btn btn-warning me-1">수정</a>
        <form action="/board/{{board.id}}/delete" method="post" id="delete-form">
            <input type="hidden" id="boardId" value="{{board.id}}">
            <button class="btn btn-danger">삭제</button>
        </form>
    </div>

    <div class="d-flex justify-content-end">
        <b>작성자</b> : {{board.username}}
    </div>

    <div>
        <h2><b>{{board.title}}</b></h2>
        <hr>
        <div class="m-4 p-2">
            {{board.content}}
        </div>
    </div>

    {{! 댓글: 아직 기능이 없어 화면만 만들어 둡니다 }}
    <div class="card mt-3">
        <div class="card-body">
            <form action="/reply/save" method="post">
                <textarea class="form-control" rows="2" name="comment" placeholder="댓글을 입력하세요"></textarea>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary mt-1">댓글 등록</button>
                </div>
            </form>
        </div>
        <div class="card-footer"><b>댓글 목록</b></div>
        <div class="list-group">
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex">
                    <div class="px-1 me-1 bg-primary text-white rounded">박지훈</div>
                    <div>댓글 내용입니다</div>
                </div>
                <form action="/reply/1/delete" method="post">
                    <button class="btn"><i class="fa-solid fa-trash"></i></button>
                </form>
            </div>
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex">
                    <div class="px-1 me-1 bg-primary text-white rounded">이서연</div>
                    <div>댓글 내용입니다</div>
                </div>
                <form action="/reply/2/delete" method="post">
                    <button class="btn"><i class="fa-solid fa-trash"></i></button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const deleteForm = document.getElementById(`delete-form`);

    deleteForm.addEventListener('submit', async (e) => {
        // 1. 폼의 기본 동작(POST 전송 후 페이지 이동, 새로고침)을 막습니다.
        e.preventDefault();

        // 2. 삭제는 되돌릴 수 없으므로 한 번 더 묻습니다.
        if (!confirm("정말 삭제하시겠습니까?")){
            return;
        }
        // 3. 숨겨둔 input 태그에 할당 되어 있는 board pk 값을 가져 온다.
        const boardId = document.getElementById("boardId").value;

        try{
            // 4. DELETE 요청, 보낼 본문이 없으므로 method 만 적습니다
            const response = await fetch(`/api/boards/${boardId}`,{method : "DELETE"} );
            // 5. 서버측에서 보낼 응답 타입과 약속이 되어 있어야 함. (응답을 텍스트로 만들 예정)
            // 서버가 보낸 문자열 메시지를 꺼냅니다.
            const message = await response.text();
            // 6. 상태 코드가 200번대가 아니면 실패로 간주
            if (!response.ok) {
                alert(response.status + message);
                return;
            }
            alert(message);
            location.href= "/";
        } catch (e) {
            alert(e + "요청 중 문제가 발생했습니다")
        }
    });
</script>

{{> layout/footer}}